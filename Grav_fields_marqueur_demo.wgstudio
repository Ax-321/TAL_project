  "shaders": [
    {
      "id": "1a434bcf-92dc-48ab-abc2-59b7d3073564",
      "name": "Init_values",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Init_values(@builtin(global_invocation_id) gid : vec3<u32>) {\n    \t\tMasses[0]=u32(WX/2);\n\t\t\t\tMasses[1]=u32(WY/2);\n\t\t\t\tMasses[2]=1000;\n\t\t\t\tMasses[3]=u32(WX/2+cos(f32(step)/50)*WX/4);\n\t\t\t\tMasses[4]=u32(WY/2+sin(f32(step)/50)*WY/4);\n\t\t\t\tMasses[5]=100;\n\t\t\t\tMasses[6]=u32(WX-(WX/2+cos(f32(step)/50)*WX/4));\n\t\t\t\tMasses[7]=u32(WY-(WY/2+sin(f32(step)/50)*WY/4));\n\t\t\t\tMasses[8]=100;\n}",
      "bufferIds": [
        "01471f0a-3b7b-4c19-9e4d-46f6c06aedca",
        "21a28b41-b749-424c-bd15-0f1f86da0341"
      ]
    },
    {
      "id": "210981ac-3a67-45b1-92ca-74185d054fed",
      "name": "Calcul_forces",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Calcul_forces(@builtin(global_invocation_id) gid : vec3<u32>) {\n    let index = gid.y * WX + gid.x;\n\t\tlet G =10.0; //6.674\n\t\tfor(var i=0 ; i<NbCorps*3 ; i+=3){\t\n\t\t\t\t//boucle à optimiser peut etre sans doute\n\t\t\t\tvar x = Masses[i];\n\t\t\t\tvar y = Masses[i+1];\n\t\t\t\tvar masse = Masses[i+2];\n\t\t\t\tvar r = distance(f32(gid.x),f32(gid.y),f32(x), f32(y));\n\t\t\t\tvar p = G*(f32(masse)/f32(r*r));\n    \t\tBuffer_calcul[index].z = Buffer_calcul[index].z + p;\n\t\t\t\tlet forces=calcul_vecteur(f32(gid.x),f32(gid.y),f32(x), f32(y), p);\n\t\t\t\tBuffer_calcul[index].x=Buffer_calcul[index].x+forces.x;\n\t\t\t\tBuffer_calcul[index].y=Buffer_calcul[index].y+forces.y;\n\t\t}\n\n}\n\nfn distance(x0 : f32, y0 : f32, x1 :f32, y1 : f32) ->f32{\n\t\tlet dist_pts=(x1-x0)*(x1-x0)+(y1-y0)*(y1-y0);\n\t\treturn dist_pts;\n}\n\nfn calcul_vecteur(x0:f32, y0:f32, x1:f32, y1:f32,p:f32)->vec2<f32>{\n\t\tlet angleX=acos((x1-x0)/(sqrt((x1-x0)*(x1-x0)+(y1-y0)*(y1-y0))));\n\t\tlet angleY=acos((y1-y0)/(sqrt((x1-x0)*(x1-x0)+(y1-y0)*(y1-y0))));\n\t\t//let radian=radians(degre);\n\t\tlet x=degrees(cos(angleX)*p);\n\t\tlet y=degrees(cos(angleY)*p);\n\t\treturn vec2<f32>(x,y);\n}\n",
      "bufferIds": [
        "tex-default",
        "01471f0a-3b7b-4c19-9e4d-46f6c06aedca",
        "21a28b41-b749-424c-bd15-0f1f86da0341"
      ]
    },
    {
      "id": "17dfbf54-af6c-4366-808c-7f85d06bfd3b",
      "name": "Mouvement_marqueurs",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Mouvement_marqueurs(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif(step==0){ //inititialisation\n\t\t\t\t\tMarqueurs[0]=10;\n\t\t\t\t\tMarqueurs[1]=10;\n\t\t\t\t\tMarqueurs[2]=1;\n\t\t\t\t\tMarqueurs[3]=0;\n\t\t}\n\t\telse{\n    \t\tfor(var y=0;y<NbMaxMarqueurs*4;y+=4){\t\n\t\t\t\t\t\t\tlet index = i32(Marqueurs[y + 1]) * WX + i32(Marqueurs[y]); \t\t\t\t//position du marqueur courant dans le buffer\n\t\t\t\t\t\t\tMarqueurs[y + 2] = Marqueurs[y + 2] + Buffer_calcul[index].x; \t\t\t\t//calcul vecteur x\n\t\t\t\t\t\t\tMarqueurs[y + 3] = Marqueurs[y + 3] + Buffer_calcul[index].y; \t\t\t\t//calcul vecteur y\n\t\t\t\t\t\t\t//Marqueurs[y] = Marqueurs[y] + Marqueurs[y + 2];\t\t\t\t //calcul position x\n\t\t\t\t\t\t\t//Marqueurs[y + 1] = Marqueurs[y + 1] + Marqueurs[y + 3];\t\t\t\t //calcul position y\n\t\t\t\t}\n\t\t\t\tfor(var i=0;i<NbMaxMarqueurs*4;i+=4){\n\t\t\t\t\t\tMarqueurs[i] = Marqueurs[i] + Marqueurs[i+2];\n\t\t\t\t\t\tMarqueurs[i+1]= Marqueurs[i+1]+Marqueurs[i+3]; \n\t\t\t\t}\n\t\t}\n}",
      "bufferIds": [
        "tex-default",
        "21a28b41-b749-424c-bd15-0f1f86da0341"
      ]
    },
    {
      "id": "d8a67948-39a2-48dc-aa2e-9071c8e37e78",
      "name": "Affiche",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Affiche(@builtin(global_invocation_id) gid : vec3<u32>) {\n    let index = gid.y * WX + gid.x;\n\t\tlet tmp=distrib_color(Buffer_calcul[index].z);\n\t\tAffichage[index].x=tmp;\n\t\tAffichage[index].y=tmp;\t\t\n\t\tAffichage[index].z=tmp;\n\t\tfor(var i=0;i<NbMaxMarqueurs*4;i+=4){\n\t\t\t\tif(u32(Marqueurs[i+1]) * WX + u32(Marqueurs[i])==index){\n\t\t\t\t\t\tAffichage[index].x=0.99;\n\t\t\t\t\t\tAffichage[index].y=0.0;\t\t\n\t\t\t\t\t\tAffichage[index].z=0.0;\n\t\t\t\t}\n\t\t}\n}\n\nfn distrib_color(val: f32)->f32{\n\t\tif(val>0.0 && val<50.0){\n\t\t\t\treturn color(val, 50.0);\n\t\t}else{\n\t\t\t\t\t\treturn 1.0;\n\t\t}\n}\n\nfn color(val: f32, val_max: f32) -> f32{\n\t\t\t\treturn sqrt(sqrt(sqrt(val/val_max)));\n}",
      "bufferIds": [
        "tex-default",
        "d416ce86-25a9-4160-806e-e75250aa74fa",
        "21a28b41-b749-424c-bd15-0f1f86da0341"
      ]
    },
    {
      "id": "ab93a917-64a0-44e2-9c72-de8ba8a05df9",
      "name": "Refresh",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Refresh(@builtin(global_invocation_id) gid : vec3<u32>) {\n    let index = gid.y * WX + gid.x;\n    Buffer_calcul[index].x = 0.0;\n\t\tBuffer_calcul[index].y = 0.0;\n\t\tBuffer_calcul[index].z = 0.0;\n}",
      "bufferIds": [
        "tex-default"
      ]
    }
  ],
  "functions": [
    {
      "id": "7cd0cc75-586d-4016-91e9-6a6c98e9199a",
      "name": "Bibliothèque 1",
      "code": "/* Exemple de fonctions \nfn clamp01(value : f32) -> f32 {\n    return max(0.0, min(1.0, value));\n}\n\nfn lerp(a : f32, b : f32, t : f32) -> f32 {\n    return a + (b - a) * clamp01(t);\n} */"
    }
  ],
